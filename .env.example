# ========================================================
# ADCom Jasa - Backend Environment Configuration
# ========================================================

# WhatsApp API Provider Configuration
# Pilihan provider yang didukung:
# - mock       : Simulasi pengujian internal (localhost / demo mode)
# - fonnte     : Fonnte WhatsApp Gateway API
# - wablas     : Wablas WhatsApp Gateway API
# - meta_cloud : Meta / WhatsApp Business Platform Cloud API resmi
# - generic    : Generic HTTP REST WhatsApp Provider
WHATSAPP_PROVIDER=mock

# URL API Endpoint dari Provider
# Contoh:
# - Fonnte     : https://api.fonnte.com/send
# - Wablas     : https://solo.wablas.com/api/send-message
# - Meta Cloud : https://graph.facebook.com/v19.0/{PHONE_NUMBER_ID}/messages
WHATSAPP_API_URL=URL_API_DARI_PROVIDER

# Token API / Bearer Token dari Provider (JANGAN PERNAH DIBAGIKAN / COMMIT KE GIT)
WHATSAPP_API_TOKEN=ISI_TOKEN_DI_ENV

# Sender ID / Instance ID / Phone Number ID (jika dibutuhkan oleh provider)
WHATSAPP_SENDER_ID=ID_PENGIRIM_JIKA_DIBUTUHKAN

# Gemini AI API Key
AI_API_KEY=ISI_API_KEY_DI_ENV
